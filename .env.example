APP_NAME=AI Knowledge & Action Platform
APP_VERSION=0.1.0
APP_DESCRIPTION=Backend platform for RAG, AI agents and knowledge-driven actions.
ENVIRONMENT=development
POSTGRES_DB=ai_platform
POSTGRES_USER=ai_platform
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://ai_platform:change_me@localhost:5432/ai_platform
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
REDIS_URL=redis://localhost:6379/0
QUERY_EMBEDDING_CACHE_TTL_SECONDS=3600
RAG_RATE_LIMIT_REQUESTS=10
RAG_RATE_LIMIT_WINDOW_SECONDS=60
AGENT_MODE=tool_calling
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ai-knowledge-action-platform
LANGSMITH_API_KEY=your_langsmith_api_key
AGENT_RECURSION_LIMIT=12
DOCKER_DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/ai_platform

AGENT_RECURSION_LIMIT=12

LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ai-knowledge-action-platform
